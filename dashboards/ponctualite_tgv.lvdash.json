{
  "datasets": [
    {
      "name": "regularite_mensuelle",
      "displayName": "Régularité mensuelle par service",
      "config": {
        "source": "SELECT f.mois,\n       f.liaison_id,\n       f.nb_trains_prevus,\n       f.nb_annulations,\n       f.nb_trains_circules,\n       f.nb_trains_retard_arrivee,\n       l.service\nFROM workspace.gold.fct_regularite_mensuelle f\nJOIN workspace.gold.dim_liaison l ON f.liaison_id = l.liaison_id\n",
        "measures": [
          {
            "displayName": "Ponctualité à l'arrivée",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "taux_ponctualite",
            "expr": "1 - try_divide(sum(nb_trains_retard_arrivee), sum(nb_trains_circules))",
            "comment": "1 - somme des retards à l'arrivée / somme des trains circulés (moyenne pondérée, jamais une moyenne de taux)"
          },
          {
            "displayName": "Taux d'annulation",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "taux_annulation",
            "expr": "try_divide(sum(nb_annulations), sum(nb_trains_prevus))",
            "comment": "Somme des annulations / somme des trains prévus, recalculé après chaque filtre"
          }
        ],
        "version": "1.1",
        "comment": "Faits mensuels x liaison avec le service. Les taux sont recalculés par sommes pondérées après chaque filtre.",
        "dimensions": [
          {
            "displayName": "Mois",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            },
            "name": "mois",
            "expr": "mois",
            "comment": "Premier jour du mois observé"
          },
          {
            "name": "annee",
            "expr": "year(mois)",
            "displayName": "Année"
          },
          {
            "name": "service",
            "expr": "service",
            "displayName": "Service",
            "comment": "NATIONAL ou INTERNATIONAL"
          }
        ]
      }
    },
    {
      "name": "classement_liaisons",
      "displayName": "Classement annuel des liaisons",
      "config": {
        "source": "SELECT annee,\n       service,\n       libelle_liaison,\n       rang_moins_ponctuelle,\n       nb_trains_circules,\n       nb_trains_prevus,\n       nb_annulations,\n       nb_trains_retard_arrivee,\n       taux_ponctualite_arrivee,\n       taux_annulation,\n       est_comparable,\n       contains(lower(libelle_liaison), 'stuttgart') AS est_liaison_vedette\nFROM workspace.gold.mart_ponctualite_liaison_annuelle\n",
        "measures": [
          {
            "displayName": "Ponctualité à l'arrivée",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "taux_ponctualite",
            "expr": "1 - try_divide(sum(nb_trains_retard_arrivee), sum(nb_trains_circules))",
            "comment": "Ponctualité recalculée par sommes pondérées après filtres"
          },
          {
            "displayName": "Taux d'annulation",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "taux_annulation_calcule",
            "expr": "try_divide(sum(nb_annulations), sum(nb_trains_prevus))",
            "comment": "Annulations / trains prévus, recalculé par sommes pondérées"
          }
        ],
        "filter": "est_comparable = true",
        "version": "1.1",
        "comment": "Liaisons comparables (au moins 200 trains circulés). La liaison Paris Est > Stuttgart est marquée pour mise en avant.",
        "dimensions": [
          {
            "name": "annee",
            "expr": "annee",
            "displayName": "Année"
          },
          {
            "name": "service",
            "expr": "service",
            "displayName": "Service"
          },
          {
            "name": "libelle_liaison",
            "expr": "libelle_liaison",
            "displayName": "Liaison"
          },
          {
            "name": "rang_moins_ponctuelle",
            "expr": "rang_moins_ponctuelle",
            "displayName": "Rang de ponctualité",
            "comment": "1 = la moins ponctuelle des liaisons comparables de l'année"
          },
          {
            "name": "nb_trains_circules",
            "expr": "nb_trains_circules",
            "displayName": "Trains circulés",
            "format": {
              "type": "number"
            }
          },
          {
            "displayName": "Ponctualité à l'arrivée",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "taux_ponctualite_arrivee",
            "expr": "taux_ponctualite_arrivee",
            "comment": "Taux stocké au grain année x liaison (moyenne pondérée)"
          },
          {
            "name": "taux_annulation",
            "expr": "taux_annulation",
            "displayName": "Taux d'annulation",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "est_liaison_vedette",
            "expr": "est_liaison_vedette",
            "comment": "Vrai pour la liaison Paris Est > Stuttgart mise en avant"
          }
        ]
      }
    },
    {
      "name": "causes_retard",
      "displayName": "Causes de retard par année",
      "config": {
        "source": "SELECT c.mois,\n       c.cause,\n       c.nb_trains_retard_attribues,\n       l.service\nFROM workspace.gold.mart_causes_retard c\nJOIN workspace.gold.dim_liaison l ON c.liaison_id = l.liaison_id\n",
        "measures": [
          {
            "displayName": "Trains en retard attribués",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "nb_trains_retard",
            "expr": "sum(nb_trains_retard_attribues)",
            "comment": "Somme des trains en retard attribués à la cause"
          }
        ],
        "version": "1.1",
        "comment": "Trains en retard attribués par cause (grain mois x liaison x cause), service récupéré via dim_liaison.",
        "dimensions": [
          {
            "name": "annee",
            "expr": "year(mois)",
            "displayName": "Année"
          },
          {
            "name": "cause",
            "expr": "cause",
            "displayName": "Cause de retard"
          },
          {
            "name": "service",
            "expr": "service",
            "displayName": "Service"
          }
        ]
      }
    },
    {
      "name": "top10_liaisons",
      "displayName": "Top 10 des liaisons les moins ponctuelles",
      "queryLines": [
        "SELECT\n",
        "  annee,\n",
        "  service,\n",
        "  libelle_liaison,\n",
        "  taux_ponctualite_arrivee\n",
        "FROM\n",
        "  workspace.gold.mart_ponctualite_liaison_annuelle\n",
        "WHERE\n",
        "  est_comparable\n",
        "  AND rang_moins_ponctuelle <= 10"
      ],
      "columns": [
        {
          "displayName": "est_liaison_vedette",
          "description": "Vrai pour la liaison Paris Est > Stuttgart mise en avant en orange dans le classement",
          "expression": "contains(lower(`libelle_liaison`), 'stuttgart')"
        }
      ]
    }
  ],
